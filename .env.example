# Tyk License
TYK_LICENSE_KEY=

# Gateway API secret — used by the admin REST API and node-to-dashboard auth.
# Must match TYK_GW_SECRET / TYK_GW_NODESECRET in tyk/confs/tyk.env.
TYK_GW_SECRET=changeme
TYK_GW_NODESECRET=changeme

# Organization
ORG="Tyk Technologies"
SLUG=tyk

# User
EMAIL=demo@tyk.io
FIRST=Demo
LAST=User
PASSWORD=topsecretpassword

# FIPS
# To enable FIPS, set TYK_GATEWAY_IMAGE to the FIPS image:
# TYK_GATEWAY_IMAGE=tykio/tyk-gateway-fips:v5.8.12
# Otherwise, leave it unset to use the default (tykio/tyk-gateway-ee)